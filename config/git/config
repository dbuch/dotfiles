[user]
	email = boogiewasthere@gmail.com
	name = Daniel Buch Hansen

[push]
	default = simple
  autoSetupRemote = true
  followTags = true

[core]
  editor = nvim
  pager = delta

[delta]
  side-by-side = true
  navigate = true
  light = false

[init]
  defaultBranch = main

[merge]
  tool = nvim
  conflictstyle = zdiff3

[mergetool]
  prompt = true

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[pull]
  rebase = true

[log]
  date = short

[interactive]
  diffFilter = delta --color-only

[alias]
  mr-checkout = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2' -
  pr-checkout = !sh -c 'git fetch origin pull/$1/head:pr-$1 && git checkout pr-$1' -

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
